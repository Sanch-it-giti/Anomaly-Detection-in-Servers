{
  "name": "dafr-research-observatory",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "data": "python3 scripts/build_evidence.py",
    "predev": "npm run data",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test:data": "python3 -m unittest discover -s tests -v",
    "prebuild": "npm run data",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort"
  },
  "dependencies": {
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
